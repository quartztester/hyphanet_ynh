#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

ynh_app_setting_set_default --key=store_size --value=1024
ynh_app_setting_set_default --key=bandwidth_limit --value=64
ynh_app_setting_set_default --key=listen_port --value=""

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"
for id in ext bcprov jna jna-platform pebble unbescape slf4j; do
	ynh_setup_source --dest_dir="$install_dir" --source_id="$id"
done
ynh_setup_source --dest_dir="$install_dir/seedrefs" --source_id=seedrefs

chown -R "$app:$app" "$install_dir"

#=================================================
# SETUP NODE STATE DIRECTORY
#=================================================
ynh_script_progression "Preparing the node datastore in $data_dir..."

mkdir -p "$data_dir"/{noderef,state,store,plugins,plugin-data,complete,tmp,run}
chown -R "$app:$app" "$data_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

store_size_bytes=$(( store_size * 1024 * 1024 ))
bandwidth_bytes=$(( bandwidth_limit * 1024 ))

ynh_config_add --template="freenet.ini" --destination="$data_dir/freenet.ini"
chown "$app:$app" "$data_dir/freenet.ini"

# -1 means random but bricks the next restart, so only pin an explicit port
if [ -n "$listen_port" ]; then
	sed -i "/^End$/i node.listenPort=$listen_port" "$data_dir/freenet.ini"
fi

cat "$install_dir"/seedrefs/* > "$data_dir/noderef/seednodes.fref"
chown "$app:$app" "$data_dir/noderef/seednodes.fref"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Freenet REference Daemon" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Node initialization completed" --log_path="/var/log/$app/$app.log"

# The node rewrites its own freenet.ini at startup; adopt that content
ynh_store_file_checksum "$data_dir/freenet.ini"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
